ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SECRET_KEY=change-this-to-a-random-long-string
MAX_CONCURRENT_DOWNLOADS=2
CLEANUP_HOURS=24
CLEANUP_INTERVAL_MINUTES=30

# Optional: password required to use the public site at all (separate from
# the admin login). Leave empty to keep the site open to anyone who can
# reach it (fine for LAN-only use). Can also be set/changed later from the
# admin settings page without touching this file.
# SITE_PASSWORD=your-shared-password

# How many days a successful login (site or admin) is remembered on a device.
SESSION_MAX_AGE_DAYS=30

# Optional: route only these domains through a proxy (e.g. to reach sites
# blocked in your country). Leave PROXY_URL empty to disable entirely.
# PROXY_URL=socks5://user:password@your-proxy-host:1080
PROXY_DOMAINS=vk.com,vk.ru,vkvideo.ru,ok.ru,rutube.ru,mail.ru
